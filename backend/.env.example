# Copy to .env and fill in.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://admin.yourdomain.com

# PostgreSQL (leave unset to use SQLite while developing)
DATABASE_URL=postgres://turflet:turflet@localhost:5432/turflet

# Cloudinary — every uploaded image (venues, sports, offers, avatars) goes here when set
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=turflet

# Email sign-in codes. In dev mode every code is 123456 and the API returns it. Set False in production.
OTP_DEV_MODE=True
# SMTP for sending codes (leave EMAIL_HOST empty to print emails in the server console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Turflet <no-reply@yourdomain.com>

# Payments: "mock" confirms instantly. Add Razorpay/etc. in payments/gateways.py.
PAYMENT_PROVIDER=mock

# UPI through the self-hosted YOUPI gateway. Set UPI_CHECKOUT=youpi to turn it on.
# Merchant id/key and webhook secret come from the YOUPI admin panel. Point YOUPI's webhook URL at
#   https://<this-backend>/api/v1/payments/youpi/webhook/
UPI_CHECKOUT=
YOUPI_API_URL=https://pay-api.yourdomain.com
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_KEY=
YOUPI_WEBHOOK_SECRET=

PUBLIC_APP_URL=turflet.app
TIME_ZONE=Asia/Kolkata

# React web app (web/): /privacy, /delete-account and /admin-panel/ on this backend redirect here
WEB_APP_URL=http://localhost:5173
# Optional: Vercel Deploy Hook URL for the web project (rebuilds prerendered SEO pages when venues change)
WEB_DEPLOY_HOOK_URL=

# NotifyKit (self-hosted notification service). With these set, push + sign-in emails go through it;
# sign-in emails fall back to the SMTP settings above if NotifyKit is unreachable.
# NOTIFICATION_SERVICE=notifications.notifykit.NotifyKitNotificationService
# NOTIFYKIT_URL=https://notify.yourdomain.com
# NOTIFYKIT_API_KEY=nk_live_...
